<div class="explorer-tree">
    <div class="explorer-header">
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            All Folders
        </button>
    </div>

    <nav class="@NavMenuCssClass explorer-nav">
        <NavLink href="" Match="NavLinkMatch.All" class="explorer-link">
            <img src="assets/icons/computer_explorer-0.png" alt="" />
            My Computer
        </NavLink>
        <NavLink href="personnel" class="explorer-link">
            <img src="assets/icons/address_book_users.png" alt="" />
            Personnel
        </NavLink>
        <NavLink href="aircraft" class="explorer-link">
            <img src="assets/icons/cd_drive-0.png" alt="" />
            Aircraft
        </NavLink>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
