@page "/personnel"

@inherits PersonnelBase
<PageTitle>Personnel</PageTitle>

@if (ShowBioDialog)
{
    <div class="win-dialog-backdrop" @onclick="HideModal" @onclick:stopPropagation="true">
        <div class="win-dialog card" @onclick:stopPropagation="true">
            <div class="card-header">
                <img src="assets/icons/address_book_user.png" class="icon-16" alt="" />
                <h5>
                    @if (SelectedPerson != null)
                    {
                        @($"{SelectedPerson.LastName}, {SelectedPerson.FirstName}")
                    }
                    else
                    {
                        <text>Bio Information</text>
                    }
                </h5>
                <button type="button" class="btn window-btn" @onclick="HideModal" aria-label="Close">x</button>
            </div>
            <div class="win-dialog-body">
            @if (SelectedPerson == null)
            {
                <span>No record selected.</span>
            }
            else if (BioLoading)
            {
                <p><em>Reading bio record…</em></p>
            }
            else
            {
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(BioTab == 0 ? "active" : null)" @onclick="@(() => BioTab = 0)">Personal</button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(BioTab == 1 ? "active" : null)" @onclick="@(() => BioTab = 1)">Service</button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(BioTab == 2 ? "active" : null)" @onclick="@(() => BioTab = 2)">Notes</button>
                    </li>
                </ul>
                <div class="tab-content bio-sheet">
                    @if (bioData == null && !HasObituary(SelectedPerson))
                    {
                        <p>No bio data found for this airman.</p>
                    }
                    else if (BioTab == 0)
                    {
                        <div class="prop-grid">
                            <label>Name</label>
                            <input class="form-95" readonly value="@($"{SelectedPerson.FirstName} {SelectedPerson.LastName}")" />
                            <label>Nickname</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioNickname)" />
                            <label>Rank</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioRank)" />
                            <label>Hometown</label>
                            <input class="form-95" readonly value="@($"{Display(bioData?.bioCity)} {Display(bioData?.bioState)}".Trim())" />
                            <label>Born at</label>
                            <input class="form-95" readonly value="@($"{Display(bioData?.bioBirthCity)} {Display(bioData?.bioBirthState)}".Trim())" />
                            <label>Prior occupation</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioOccupationPrior)" />
                            <label>Post occupation</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioOccupationAfter)" />
                        </div>
                    }
                    else if (BioTab == 1)
                    {
                        <div class="prop-grid">
                            <label>Entered at</label>
                            <input class="form-95" readonly value="@($"{Display(bioData?.bioEntryLocation)} {Display(bioData?.bioEntryState)}".Trim())" />
                            <label>Entered</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioDateEnteredService)" />
                            <label>Flight crew position</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioFlightCrewPosition)" />
                            <label>Cadet class</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioCadetClass)" />
                            <label>Graduated</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioGraduationLocation)" />
                            <label>Special training</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioSpecialTraining)" />
                            <label>Arrived</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioLocationArrivalDate)" />
                            <label>Arrived from</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioArrivedFrom)" />
                            <label>Arrived via</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioArrivedHow)" />
                            <label>Departed</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioDepartedFrom)" />
                            <label>Departed from</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioDepartedLocation)" />
                            <label>Departed via</label>
                            <input class="form-95" readonly value="@Display(bioData?.bioDepartedHow)" />
                        </div>
                    }
                    else
                    {
                        <label>Details</label>
                        <textarea class="form-95" rows="4" readonly>@Display(bioData?.bioDetails)</textarea>
                        <label>Trip details</label>
                        <textarea class="form-95" rows="3" readonly>@Display(bioData?.bioTripDetails)</textarea>
                        <label>Obituary</label>
                        <textarea class="form-95" rows="4" readonly>@Display(SelectedPerson.ObituaryComments)</textarea>
                    }
                </div>
            }
            </div>
            <div class="win-dialog-footer">
                <span class="small font-italic">* not all bio data available is displayed.</span>
                <button type="button" class="btn" @onclick="HideModal">OK</button>
            </div>
        </div>
    </div>
}

<div class="page-fill">
<div class="list-toolbar">
    <img src="assets/icons/search_file-0.png" class="icon-16" alt="" />
    <label for="personnel-find">Find</label>
    <input id="personnel-find" @key="@FindEpoch" class="form-95 find-box" value="@Filter" @oninput="OnFilterInput" placeholder="Name, ID, group, squadron" />
    <label class="toolbar-check">
        <input type="checkbox" checked="@BiosOnly" @onchange="OnBiosOnlyChanged" />
        Bios only
    </label>
    <label class="toolbar-check">
        <input type="checkbox" checked="@KiaOnly" @onchange="OnKiaOnlyChanged" />
        KIA only
    </label>
    <button type="button" class="btn" disabled="@(SelectedPerson == null || (!SelectedPerson.HasBio && !HasObituary(SelectedPerson)))" @onclick="OpenSelectedAsync">Open</button>
    <button type="button" class="btn" @onclick="@(() => ReloadAsync(true))">Refresh</button>
</div>

@if (LoadError != null)
{
    <p class="load-error">@LoadError</p>
}
else
{
    <div class="listview">
        <div class="sunken-panel listview-body">
        <div class="listview-header personnel-grid">
            <button type="button" class="lv-col" @onclick="@(() => SortBy("PerIdentification"))">ID @SortMark("PerIdentification")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("FirstName"))">First Name @SortMark("FirstName")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("LastName"))">Last Name @SortMark("LastName")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("HasBio"))">Bio @SortMark("HasBio")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("HasKia"))">KIA @SortMark("HasKia")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("PerGroup"))">Flight Group @SortMark("PerGroup")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("PerSquadron"))">Squadron @SortMark("PerSquadron")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("DeceasedDate"))">Deceased @SortMark("DeceasedDate")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("Obituary"))">Obituary @SortMark("Obituary")</button>
        </div>
            @if (IsScanning)
            {
                <div class="empty-list">Reading Personnel.mdb…</div>
            }
            else if (View.Count == 0)
            {
                <div class="empty-list">No items match your search.</div>
            }
            else if (ShowFullList)
            {
                <Virtualize @key="@($"{SortColumn}:{SortAscending}:{BiosOnly}:{KiaOnly}:{Filter}:{View.Count}")" Items="View" Context="person" ItemSize="22" OverscanCount="40">
                    <PersonnelRow Person="person"
                                  Selected="@(SelectedPerson != null && SelectedPerson.PerIdentification == person.PerIdentification)"
                                  HasObituary="HasObituary(person)"
                                  OnSelect="SelectRow"
                                  OnViewBio="ShowModal" />
                </Virtualize>
            }
            else
            {
                @foreach (var person in VisibleRows)
                {
                    <PersonnelRow @key="person.PerIdentification" Person="person"
                                  Selected="@(SelectedPerson != null && SelectedPerson.PerIdentification == person.PerIdentification)"
                                  HasObituary="HasObituary(person)"
                                  OnSelect="SelectRow"
                                  OnViewBio="ShowModal" />
                }
            }
        </div>
    </div>
    <div class="status-bar">
        <span class="status-field">
            @if (IsScanning)
            {
                <text>Reading Personnel.mdb…</text>
            }
            else if (!ShowFullList && View.Count > VisibleCap)
            {
                <text>@View.Count record(s). Showing first @VisibleCap. Loading the rest…</text>
            }
            else
            {
                @View.Count <text>record(s)</text>
            }
        </span>
        <span class="status-field">@(SelectedPerson == null ? "Ready" : $"{SelectedPerson.LastName}, {SelectedPerson.FirstName}")</span>
    </div>
}
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "select")]
    public string? QuerySelect { get => SelectId; set => SelectId = value; }
}
