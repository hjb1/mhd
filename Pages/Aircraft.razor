@page "/aircraft"

@inherits AircraftBase
<PageTitle>Aircraft</PageTitle>

@if (ShowMissionsDialog)
{
    <div class="win-dialog-backdrop" @onclick="HideModal">
        <div class="win-dialog card" @onclick:stopPropagation="true">
            <div class="card-header">
                <img src="assets/icons/cd_drive-0.png" class="icon-16" alt="" />
                <h5>Missions for Aircraft @SelectedAirCraft.acAircraftNo</h5>
                <button type="button" class="btn window-btn" @onclick="HideModal" aria-label="Close">x</button>
            </div>
            <div class="win-dialog-body">
            @if (MissionsLoading)
            {
                <p><em>Reading mission records...</em></p>
            }
            else if (missionCrewSummaries.Mission.Count == 0)
            {
                <p><em>No missions found</em></p>
            }
            else
            {
                <table class="interactive mission-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Mission No</th>
                            <th># of Crew</th>
                            <th>Aircraft Position</th>
                            <th>Squadron Position</th>
                            <th>Plane Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mission in missionCrewSummaries.Mission)
                        {
                            var expanded = ExpandedMissionNo == mission.misMissionNo;
                            <tr class="@(expanded ? "highlighted" : null)" @onclick="@(() => ToggleMission(mission.misMissionNo))">
                                <td>@(expanded ? "▼" : "►")</td>
                                <td>@mission.misMissionNo</td>
                                <td>@mission.MissionCrew.Count</td>
                                <td>@mission.acmAircraftPosition</td>
                                <td>@mission.acmSquadronPos</td>
                                <td class="wrap-cell">@mission.acmPlaneRemarks</td>
                            </tr>
                            @if (expanded)
                            {
                                <tr class="crew-row">
                                    <td colspan="6">
                                        @if (mission.MissionCrew.Count == 0)
                                        {
                                            <em>No crew listed for this mission.</em>
                                        }
                                        else
                                        {
                                            <table>
                                                <thead>
                                                    <tr>
                                                        <th>Rank</th>
                                                        <th>Name</th>
                                                        <th>Duties</th>
                                                        <th>Status</th>
                                                        <th>Remarks</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var crew in mission.MissionCrew)
                                                    {
                                                        <tr>
                                                            <td>@crew.Rank</td>
                                                            <td>@CrewName(crew)</td>
                                                            <td>@crew.Duties</td>
                                                            <td>@crew.Status</td>
                                                            <td class="wrap-cell">@crew.NameRemarks</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            </div>
            <div class="win-dialog-footer">
                <button type="button" class="btn" @onclick="HideModal">OK</button>
            </div>
        </div>
    </div>
}

<div class="page-fill">
<div class="list-toolbar">
    <img src="assets/icons/search_file-0.png" class="icon-16" alt="" />
    <label for="aircraft-find">Find</label>
    <input id="aircraft-find" class="form-95 find-box" value="@Filter" @oninput="OnFilterInput" placeholder="Number, name, group, squadron" />
    <label class="toolbar-check">
        <input type="checkbox" checked="@Only44th" @onchange="OnOnly44thChanged" />
        44th Bomb Group
    </label>
    <button type="button" class="btn" disabled="@(SelectedAirCraft.acBG != "44th")" @onclick="OpenSelectedAsync">Missions</button>
    <button type="button" class="btn" @onclick="@(() => ReloadAsync(true))">Refresh</button>
</div>

@if (LoadError != null)
{
    <p class="load-error">@LoadError</p>
}
else
{
    <div class="listview">
        <div class="listview-header aircraft-grid">
            <button type="button" class="lv-col" @onclick="@(() => SortBy("acAircraftNo"))">Aircraft # @SortMark("acAircraftNo")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("acAircraftLetter"))">Letter @SortMark("acAircraftLetter")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("acAircraftName"))">Name @SortMark("acAircraftName")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("acBG"))">Bomb Group @SortMark("acBG")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("acSquadron"))">Squadron @SortMark("acSquadron")</button>
            <button type="button" class="lv-col" @onclick="@(() => SortBy("acFinalAircraftDisposition"))">Disposition @SortMark("acFinalAircraftDisposition")</button>
            <span class="lv-col">Missions</span>
        </div>
        <div class="sunken-panel listview-body">
            @if (IsScanning)
            {
                <div class="empty-list">Reading Aircraft.mdb…</div>
            }
            else if (View.Count == 0)
            {
                <div class="empty-list">No items match your search.</div>
            }
            else if (ShowFullList)
            {
                <Virtualize Items="View" Context="aircraft" ItemSize="22" OverscanCount="40">
                    <div class="lv-row aircraft-grid @(SelectedAirCraft == aircraft ? "highlighted" : null)"
                         @onclick="@(() => SelectRow(aircraft))"
                         @ondblclick="@(() => OpenSelectedAsync())">
                        <span>@aircraft.acAircraftNo</span>
                        <span>@aircraft.acAircraftLetter</span>
                        <span>@aircraft.acAircraftName</span>
                        <span>@aircraft.acBG</span>
                        <span>@aircraft.acSquadron</span>
                        <span class="clip-cell" title="@aircraft.acFinalAircraftDisposition">@aircraft.acFinalAircraftDisposition</span>
                        <span>
                            @if (aircraft.acBG == "44th")
                            {
                                <button type="button" class="btn btn-sm" @onclick="@(() => ShowModal(aircraft))" @onclick:stopPropagation="true">View Missions</button>
                            }
                        </span>
                    </div>
                </Virtualize>
            }
            else
            {
                @foreach (var aircraft in VisibleRows)
                {
                    <div class="lv-row aircraft-grid @(SelectedAirCraft == aircraft ? "highlighted" : null)"
                         @onclick="@(() => SelectRow(aircraft))"
                         @ondblclick="@(() => OpenSelectedAsync())">
                        <span>@aircraft.acAircraftNo</span>
                        <span>@aircraft.acAircraftLetter</span>
                        <span>@aircraft.acAircraftName</span>
                        <span>@aircraft.acBG</span>
                        <span>@aircraft.acSquadron</span>
                        <span class="clip-cell" title="@aircraft.acFinalAircraftDisposition">@aircraft.acFinalAircraftDisposition</span>
                        <span>
                            @if (aircraft.acBG == "44th")
                            {
                                <button type="button" class="btn btn-sm" @onclick="@(() => ShowModal(aircraft))" @onclick:stopPropagation="true">View Missions</button>
                            }
                        </span>
                    </div>
                }
            }
        </div>
    </div>
    <div class="status-bar">
        <span class="status-field">
            @if (IsScanning)
            {
                <text>Reading Aircraft.mdb…</text>
            }
            else if (!ShowFullList && View.Count > VisibleCap)
            {
                <text>@View.Count aircraft. Showing first @VisibleCap. Loading the rest…</text>
            }
            else
            {
                @View.Count <text>aircraft</text>
            }
        </span>
        <span class="status-field">@(string.IsNullOrEmpty(SelectedAirCraft.acAircraftNo) ? "Ready" : SelectedAirCraft.acAircraftNo)</span>
    </div>
}
</div>
