@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace mhd.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/win95.css" rel="stylesheet" asp-append-version="true" />
    <link href="mhd.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="Server" />
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <script>
        window.mhd = {
            ping: function () { return 1; },
            scrollPerson: function (id) {
                if (!id) { return 0; }
                var el = document.querySelector('.listview-body [data-person-id="' + id + '"]')
                    || document.querySelector('.listview-body .lv-row.highlighted');
                if (el) {
                    el.scrollIntoView({ block: 'center' });
                }
                return 1;
            },
            scrollCrew: function (id) {
                if (!id) { return 0; }
                var el = document.querySelector('.mission-table [data-crew-id="' + id + '"]')
                    || document.querySelector('.mission-table tr.highlighted');
                if (el) {
                    el.scrollIntoView({ block: 'nearest' });
                }
                return 1;
            },
            localClock: function () {
                var d = new Date();
                var tz = '';
                try {
                    tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
                } catch (e) {
                }
                function pad(n) { return (n < 10 ? '0' : '') + n; }
                var time = pad(d.getHours()) + ':' + pad(d.getMinutes());
                var title = d.toLocaleDateString('en-US', {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                }) + ' ' + time + ':' + pad(d.getSeconds());
                if (tz) {
                    title += ' — ' + tz;
                }
                return { time: time, title: title, timeZone: tz };
            }
        };
    </script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
