@page "/"

<PageTitle>Military Heritage Database</PageTitle>

<div class="home-scroll">
<div class="home-grid">
    <div class="card">
        <div class="card-header">
            <img src="assets/icons/help_book_cool-0.png" class="icon-16" alt="" />
            About Military Heritage Database
        </div>
        <div class="card-body about-copy">
            <p><strong>United States Air Force</strong></p>
            <p>Military Heritage Database</p>
            <p>World War II</p>
            <p class="motto">"Remember And Share ... With Those Who Were There"</p>
            <p>
                Eighth Air Force<br />
                Second Air Division<br />
                44th Bomb Group
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <img src="assets/icons/cd_drive-0.png" class="icon-16" alt="" />
            Programs
        </div>
        <div class="card-body program-icons">
            <NavLink href="personnel" class="desktop-icon">
                <img src="assets/icons/address_book_users.png" alt="" />
                <span>Personnel</span>
            </NavLink>
            <NavLink href="aircraft" class="desktop-icon">
                <img src="assets/icons/cd_drive-0.png" alt="" />
                <span>Aircraft</span>
            </NavLink>
            <a href="https://twitter.com/mtruslowstorey/status/1703781076689121556" class="desktop-icon" target="_blank" rel="noopener noreferrer">
                <img src="assets/icons/internet_connection_wiz-5.png" alt="" />
                <span>Thread</span>
            </a>
            <a href="https://github.com/hjb1/mhd" class="desktop-icon" target="_blank" rel="noopener noreferrer">
                <img src="assets/icons/help_sheet-0.png" alt="" />
                <span>GitHub</span>
            </a>
        </div>
    </div>
</div>

<div class="card photo-window">
    <div class="card-header">
        <img src="assets/icons/camera-0.png" class="icon-16" alt="" />
        Pictures
    </div>
    <div class="card-body">
        <img class="img-fluid" src="https://mhd09192023.blob.core.windows.net/mhdimg/F6UL2L6XQAAop2e-2.webp" alt="Heritage photograph" loading="lazy" decoding="async" />
        <img class="img-fluid" src="https://mhd09192023.blob.core.windows.net/mhdimg/F6ULzH9WMAAExJT-2.webp" alt="Heritage photograph" loading="lazy" decoding="async" />
    </div>
</div>
</div>
